# ---- Application ----
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ---- Database ----
# Start pgvector:  docker run -d --name eraga-pg -p 55432:5432 pgvector/pgvector:pg16
# Host port 55432 avoids clashing with a system-installed PostgreSQL on 5432.
DATABASE_URL=postgresql+asyncpg://eraga:eraga@localhost:55432/eraga

# ---- Providers ----
# Cloud stack: Groq (LLM) + Jina (embeddings & rerank), both free tier.
# WARNING: retrieved document text is sent to these APIs (data egress).
# Offline alternatives: LLM_PROVIDER=fake, EMBEDDING_PROVIDER=hash, RERANK_PROVIDER=none.
LLM_PROVIDER=groq          # groq | fake
EMBEDDING_PROVIDER=jina    # jina | hash
RERANK_PROVIDER=jina       # jina | none

# ---- Groq (LLM, OpenAI-compatible) — free key at https://console.groq.com/keys ----
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b   # or openai/gpt-oss-120b, qwen/qwen3.8-27b
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=180

# ---- Jina AI (embeddings + rerank) — free key at https://jina.ai/ ----
# jina-embeddings-v3 is Matryoshka, so EMBEDDING_DIM=768 keeps the existing
# vector(768) schema (native size is 1024).
JINA_API_KEY=
JINA_BASE_URL=https://api.jina.ai/v1
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
JINA_TIMEOUT_S=60
EMBEDDING_DIM=768

# ---- Retrieval tuning ----
TOP_K=8
RERANK_TOP_N=5
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# ---- Security ----
JWT_SECRET=change-me-in-production
ADMIN_ROLES=admin
