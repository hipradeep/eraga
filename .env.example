# ---- Application ----
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://eraga:eraga@localhost:5432/eraga

# ---- Queue / Cache ----
REDIS_URL=redis://localhost:6379/0

# ---- LLM ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Embeddings ----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Retrieval ----
TOP_K=8
RERANK_TOP_N=5

# ---- Security ----
JWT_SECRET=change-me-in-production
ADMIN_ROLES=admin